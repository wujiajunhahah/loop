VOICE_DIARY_DEVICE_TOKEN=
HRV_BASELINE_MODE=fixed
HRV_FIXED_BASELINE=50
HRV_LOW_RATIO=0.85
HRV_HIGH_RATIO=1.15
HRV_READING_TTL_SECONDS=900
DATABASE_URL=sqlite:///./pigeon.db
