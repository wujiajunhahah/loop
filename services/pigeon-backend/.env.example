OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=
OPENAI_REASONING_EFFORT=low
MODEL_MODE=auto
ALLOOP_DEVICE_TOKENS=alloop-demo-001:change-this-device-token
VOICE_DIARY_STORAGE_DIR=./storage/voice-diary
VOICE_DIARY_MAX_BYTES=5242880
