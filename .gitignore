node_modules/
dist/
coverage/
.env
.env.*
!.env.example
*.local
*.log
*.tsbuildinfo
.DS_Store

# Browser-test evidence is generated only when a run fails.
test-results/
playwright-report/
blob-report/

# Skills are installed locally from the pinned sources in skills-lock.json.
.agents/
.opencode/skills/

# Impeccable ephemeral output; shared config and critique reports remain trackable.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png

# HyperFrames generated caches and draft renders; keep composition sources and
# explicitly approved delivery files trackable.
videos/*/.hyperframes/
videos/*/.thumbnails/
videos/*/renders/draft*.mp4
videos/*/renders/*.tmp
