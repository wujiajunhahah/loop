# Required. Create this key in Resend and store the real value only in Vercel.
RESEND_API_KEY=re_xxxxxxxxx

# Optional overrides. These defaults are already used by the Functions.
RESEND_FROM_EMAIL="我在 <hello@wozai.space>"
SITE_URL=https://www.wozai.space

# Recommended independent secret for 24-hour subscription confirmation links.
# If omitted, the Resend API key is used for signing.
SUBSCRIBE_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional. Set these after creating a Resend Segment or Topic.
RESEND_SEGMENT_ID=
RESEND_TOPIC_ID=
