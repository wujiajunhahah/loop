# Loop's foundation runs entirely with in-memory adapters.
# Add provider-specific values only when a later task introduces an API adapter.
VITE_APP_MODE=mock

# Optional physical-device configuration. OMI sizes are payload bytes after
# the official 3-byte header, keyed by fragment index.
VITE_OMI_FRAGMENT_LAYOUT=
VITE_OMI_FIRMWARE_MODEL=
VITE_OMI_FIRMWARE_VERSION=

# Comma-separated, reviewed ring discovery hints. These identify a device but
# do not enable byte parsing without a vendor profile in source code.
VITE_RING_DISCOVERY_NAMES=
VITE_RING_DISCOVERY_SERVICE_IDS=
